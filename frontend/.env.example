VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Sentry error reporting, tracing, and session replay. Create a Sentry project,
# then copy the DSN from the project settings. When VITE_SENTRY_DSN is unset the
# SDK is never initialized (no events sent), so dev and tests need no special
# handling (mirrors the backend's SENTRY_DSN).
VITE_SENTRY_DSN=
# Segments events in the Sentry UI (e.g. "production", "staging", "development").
VITE_SENTRY_ENVIRONMENT=development
# Fraction of navigations/page loads turned into performance transactions. 1.0
# captures everything (fine locally); lower it in prod (e.g. 0.1) to control volume.
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
# Distributed tracing: comma-separated list of request targets that get the
# sentry-trace/baggage headers attached, linking frontend traces to the backend
# transaction they trigger. Defaults to same-origin /api calls; set explicitly for
# a cross-origin API (e.g. "https://api.yourapp.com"). NOTE: a cross-origin API must
# also allow the "sentry-trace" and "baggage" request headers via CORS.
VITE_SENTRY_TRACE_PROPAGATION_TARGETS=/api
# Session Replay sampling: a small share of ordinary sessions, and always on error.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Whether to attach PII (client IP, etc.). Off by default; secrets are scrubbed
# via beforeSend either way.
VITE_SENTRY_SEND_DEFAULT_PII=false
# Ties events to a deployed version (optional).
VITE_SENTRY_RELEASE=

# Source map upload (build-time only, optional). When SENTRY_AUTH_TOKEN is set the
# Vite build uploads source maps so production stack traces are readable. Leave
# unset for local builds. Create the token in Sentry under Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
